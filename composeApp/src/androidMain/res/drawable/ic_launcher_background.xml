<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1080"
    android:viewportHeight="1080">

    <!-- Full-bleed deep navy, lit from the top-left so the mark reads on light and dark
         wallpapers alike. Full square: adaptive launchers mask this to circle or squircle. -->
    <path android:pathData="M0,0 h1080 v1080 h-1080 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1080"
                android:endY="1080"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF16344E"/>
                <item android:offset="1.0" android:color="#FF07131F"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
