<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NstkWindowsApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged app (no MSIX) — simplest setup for `dotnet run` in a test VM.
         Still gets a real MSI installer (see windowsApp/packaging/windows/Product.wxs),
         just not an MSIX package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- Local-dev fallback; the package-windows CI job overrides this via
         -p:Version=/-p:FileVersion=/-p:AssemblyVersion= from gradle.properties'
         app.version, the same single source of truth Android/Linux packaging use. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>

  <ItemGroup>
    <!-- The JVM backend jar this app spawns as a subprocess — build it with
         `gradlew :windowsApp:backend:fatJar` and drop it here before running,
         or point BackendClient at a different path. Not built by this project. -->
    <None Include="backend\nstk-windows-backend.jar" Condition="Exists('backend\nstk-windows-backend.jar')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Bundled minimal JRE (built via `gradlew :windowsApp:backend:jlinkRuntime`),
         copied here from windowsApp/backend/build/runtime before building/publishing.
         See BackendClient.ResolveJavaExecutable, which invokes runtime\bin\java.exe
         relative to AppContext.BaseDirectory, falling back to PATH if this folder is
         absent (e.g. local dev builds that skip the jlink step). -->
    <None Include="runtime\**" Condition="Exists('runtime')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtime\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- <ApplicationIcon> above only embeds this into the .exe's own resources
         (Explorer/taskbar) — AppWindow.SetIcon() in MainWindow.xaml.cs loads it
         from a file on disk at runtime for the titlebar icon, so it also needs
         to be copied to the output directory. -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
