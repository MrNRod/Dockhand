<Page
    x:Class="NstkWindowsApp.Views.SplitMergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="SplitToggle" Content="Split" IsChecked="True" Click="SplitToggle_Click" />
                    <ToggleButton x:Name="MergeToggle" Content="Merge" Click="MergeToggle_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SelectFilesButton" Content="Select File…" Click="SelectFiles_Click" />
                    <Button Content="Clear" Click="Clear_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Save to:" VerticalAlignment="Center" />
                    <TextBlock x:Name="OutputDirText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Content="Change…" Click="ChangeOutputDir_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
            <ListView x:Name="PathsList" />
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" />

        <Button Grid.Row="3" x:Name="ActionButton" Content="Split" HorizontalAlignment="Right"
                Style="{ThemeResource AccentButtonStyle}" Click="Action_Click" IsEnabled="False" />
    </Grid>
</Page>
