<Page
    x:Class="DockhandWindowsApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="8">
                <RadioButton x:Name="ThemeSystemRadio" Content="Use system setting" GroupName="ThemeGroup"
                             Tag="System" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="ThemeGroup"
                             Tag="Light" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="ThemeGroup"
                             Tag="Dark" Checked="ThemeRadio_Checked" />
            </StackPanel>

            <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Header="Auto-check for updates on launch"
                          Toggled="AutoCheckUpdatesToggle_Toggled" />
            <ToggleSwitch x:Name="UseRomFolderToggle" Header="Select folder with ROM files instead of individually"
                          Toggled="UseRomFolderToggle_Toggled" />

            <TextBlock Text="File Selection" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ToggleSwitch x:Name="AllowXciToggle" Header="Allow XCI / NSZ / XCZ selection"
                          Toggled="AllowXciToggle_Toggled" />
        </StackPanel>
    </ScrollViewer>
</Page>
