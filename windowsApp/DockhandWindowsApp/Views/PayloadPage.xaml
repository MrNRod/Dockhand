<Page
    x:Class="DockhandWindowsApp.Views.PayloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Select Payload (.bin)" Click="SelectPayload_Click" />
                <TextBlock x:Name="PayloadNameText" Text="No file selected" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>

        <Button Grid.Row="1" x:Name="InjectButton" Content="Inject Payload"
                Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                Click="Inject_Click" IsEnabled="False" />

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
            <ScrollViewer>
                <TextBlock x:Name="LogText" Padding="8" FontFamily="Cascadia Mono, Consolas"
                           Text="Ready for RCM injection." TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
